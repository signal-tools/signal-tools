{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*.css",
			"**/*.js",
			"**/*.mjs",
			"**/*.json",
			"**/*.jsonc",
			"**/*.ts",
			"!**/*.d.ts",
			"!!**/coverage",
			"!!**/dist",
			"!!**/node_modules",
			"!!**/playwright-report",
			"!!**/test-results"
		]
	},
	"formatter": {
		"enabled": true,
		"useEditorconfig": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noCommaOperator": "off",
				"noStaticOnlyClass": "off",
				"noThisInStatic": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useShorthandFunctionType": "off",
				"useTemplate": "off"
			},
			"suspicious": {
				"noAssignInExpressions": "off",
				"noConstEnum": "off",
				"noExplicitAny": "off",
				"noMisleadingInstantiator": "off",
				"noShadowRestrictedNames": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab",
			"trailingCommas": "none"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
